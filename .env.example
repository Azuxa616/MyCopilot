# ─── 统一环境变量模板（仓库根 .env 是唯一事实来源）──────────────────────────
# 用法：复制为 .env（cp .env.example .env），dev 启动器（scripts/dev.mjs）
# 会加载它并注入 server；web 的 VITE_* 变量也从这里读（vite envDir 指向仓库根）。
# Docker 部署不读本文件——使用 docker/.env.personal 或 docker/.env.demo。
# 注意：shell 中已导出的同名变量优先于本文件。

# ── Server ──────────────────────────────────────────────────────────────────
AUTH_TOKEN=                  # 访问 token，留空则启动时自动生成并持久化到 SQLite
DATA_DIR=./data              # SQLite 数据目录（相对 server 进程，保持默认即可）
PORT=3000                    # 监听端口
CORS_ORIGIN=http://localhost:5173  # 逗号分隔；生产按域名设置
SERVER_PUBLIC_DIR=           # 空=纯 API；设路径=同时托管 web 构建产物（单容器）
LOG_LEVEL=info               # debug|info|warn|error
MAX_ATTACHMENT_SIZE_MB=10    # 单附件大小上限（MB）
SKILLS_DIR=                  # 可选：目录 Skills 来源（相对仓库根）
SKILL_IMPORT_ALLOWED_HOSTS=github.com,codeload.github.com  # Skill 仓库导入域名白名单
SKILL_IMPORT_MAX_MB=10       # Skill 仓库归档压缩层上限（MB）

# ── Plugins ─────────────────────────────────────────────────────────────────
# 插件根目录（相对仓库根；dev 启动器会解析为绝对路径）。插件安装方式：
# POST /api/plugins/install {"directory": "<子目录名>"}
PLUGINS_DIR=plugins

# ── Web（Vite 构建期变量，前缀 VITE_）──────────────────────────────────────
VITE_API_BASE_URL=           # 留空=dev 走代理/生产走同源；独立部署前端时填 API 地址
