# docker/.env.personal.example
# 自用实例（泳道 personal）环境变量。
# 复制为 docker/.env.personal 并填入真实值。此文件含密钥，永不提交。
#   cp .env.personal.example .env.personal

# 管理员 token：openssl rand -hex 32
AUTH_TOKEN=

# 镜像（默认 GHCR latest，CI 每次发布同步更新）
# IMAGE=ghcr.io/azuxa616/my-copilot:latest

# 附件上限（MB），自用可放宽
MAX_ATTACHMENT_SIZE_MB=20

# 自用实例仅本机/隧道访问，CORS 放开即可
CORS_ORIGIN=*
